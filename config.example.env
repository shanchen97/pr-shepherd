# PR-Shepherd configuration — copy to `config.env` and fill in.
# `config.env` holds real values and is gitignored; only this example is committed.
# run.sh sources this file and injects the values into INSTRUCTIONS.md at runtime,
# so no org name, username, path, port, or notifier id ever lives in the repo.

# --- GitHub identity ---------------------------------------------------------
# Your GitHub login (whose PRs are watched / who gets review-requested).
GITHUB_USER="your-github-login"
# The org that owns the repos below.
GITHUB_ORG="your-org"
# Team slug for the team-review-requested query (usually "<org>/<team>").
GITHUB_TEAM="your-org/your-team"

# --- Repo whitelist ----------------------------------------------------------
# The ONLY repos that get scanned. One `repo=local-checkout-path` per line.
# The local path is used to review the full code: before reviewing a PR, a
# throwaway `git worktree` is added at the PR head, so your working tree and
# current branch are never touched (the path may be your day-to-day checkout).
# No spaces in repo names or paths. A repo with no local checkout can be
# omitted (it simply won't be scanned).
REPO_WHITELIST="
repo-one=/path/to/repo-one
repo-two=/path/to/repo-two
"

# --- Local context -----------------------------------------------------------
# Extra dirs prepended to PATH in the headless launchd environment (colon-sep).
# Point at wherever the chosen agent CLI, python3, gh, git and notifier CLI live.
EXTRA_PATH="/path/to/your/.local/bin"

# --- Report server -----------------------------------------------------------
# The report LaunchAgent serves reviews/ over HTTP so chat links are clickable.
REPORT_PORT="8899"
REPORT_BASE_URL="http://127.0.0.1:8899"

# --- Notifications -----------------------------------------------------------
# Recipient id for the notifier CLI. Leave empty to disable all notifications.
NOTIFY_USER_ID=""

# --- Review tuning -----------------------------------------------------------
# Base branches to watch (space-separated globs; PRs onto other bases skip).
BASE_BRANCHES="develop main release*"

# --- Mine-line triage --------------------------------------------------------
# Per-PR notes (<dir>/<repo>/<pr>.md, <pr>.design.md) read as decision context.
PR_NOTES_DIR="/path/to/.claude/pr-notes"
# Shared cargo target dir for patch verification in review worktrees.
SHEPHERD_CARGO_TARGET="/path/to/.cache/pr-shepherd-target"

# --- Agent and model ---------------------------------------------------------
# claude (default): Claude Code auto mode. cursor: Cursor Agent --auto-review.
REVIEW_AGENT="claude"
# Optional: omitted means the selected CLI's default model.
# Cursor example: REVIEW_MODEL="grok-4.7-high"
# REVIEW_MODEL="opus"
# Claude only; optional CLI fallback model (not a retry of a failed run).
# FALLBACK_MODEL="claude-fable-5"
